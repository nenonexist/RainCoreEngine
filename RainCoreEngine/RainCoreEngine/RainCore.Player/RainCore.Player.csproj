<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>RainCore.Player</RootNamespace>
    <AssemblyName>RainCore.Player</AssemblyName>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
                                                                         
                                                       
                                                               
                                           
                                                                       
                                                                    
                                                                           
                                                                         
                                                                
                                                                           
                            
    <ProjectReference Include="..\RainCore.Voxel\RainCore.Voxel.csproj" />
    <ProjectReference Include="..\RainCore.Core\RainCore.Core.csproj" />
    <ProjectReference Include="..\RainCore.Scene\RainCore.Scene.csproj" />
    <ProjectReference Include="..\RainCore.Project\RainCore.Project.csproj" />
    <ProjectReference Include="..\RainCore.Scripting\RainCore.Scripting.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTK" Version="4.8.2" />
    <PackageReference Include="NVorbis" Version="0.10.5" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>

  <ItemGroup>
                                                                              
                                                                        
    <None Update="Shaders\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
